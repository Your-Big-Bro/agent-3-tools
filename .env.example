# --- РњРѕРґРµР»СЊ -----------------------------------------------------------------
# mock   вЂ” Р±РµР· РјРѕРґРµР»Рё, РґРµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅС‹Р№ СЂРѕСѓС‚РµСЂ (СЂР°Р±РѕС‚Р°РµС‚ СЃСЂР°Р·Сѓ)
# ollama вЂ” Р»РѕРєР°Р»СЊРЅР°СЏ РјРѕРґРµР»СЊ С‡РµСЂРµР· Ollama
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:3b-instruct

# Р”Р»СЏ Р·Р°РїСѓСЃРєР° РїСЂРёР»РѕР¶РµРЅРёСЏ РІ Docker Ollama Р¶РёРІС‘С‚ РЅР° С…РѕСЃС‚Рµ:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- РЇР·С‹Рє РїСЂРѕРјРїС‚РѕРІ ----------------------------------------------------------
# ru | en вЂ” РєР°РєРѕР№ РєРѕРјРїР»РµРєС‚ РїСЂРѕРјРїС‚РѕРІ Рё РѕРїРёСЃР°РЅРёР№ РёРЅСЃС‚СЂСѓРјРµРЅС‚РѕРІ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ
PROMPT_LANG=ru

# --- РўСЂРµР№СЃРёРЅРі LangSmith -----------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_РІР°С€_РєР»СЋС‡
LANGSMITH_PROJECT=agent-3-tools
# Р”Р»СЏ EU-Р°РєРєР°СѓРЅС‚Р°:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- РџСЂРѕС‡РµРµ -----------------------------------------------------------------
APP_TIMEZONE=Europe/Moscow
